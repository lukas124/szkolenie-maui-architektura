<Project>
  <!-- Centralne zarządzanie wersjami pakietów NuGet (jedno miejsce na wersje) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Wersje z tego pliku obowiązują też dla pakietów przechodnich (tu: natywny SQLite, patrz niżej) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI (jedyny projekt MAUI) -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
    <!-- Lokalna baza SQLite. bundle_green = natywny SQLite dla Androida (e_sqlite3) i systemowy na iOS -->
    <PackageVersion Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageVersion Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <!-- bundle_green 2.1.11 (ostatnia wersja) ciągnie natywny SQLite z luką GHSA-2m69-gcr7-jv3q (NU1903) —
         przypinamy poprawione biblioteki natywne 2.1.13 -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <!-- Application i Infrastructure: rejestracje w kontenerze, klient HTTP -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <!-- Klient API generowany w buildzie z pliku OpenAPI (Infrastructure) -->
    <PackageVersion Include="NSwag.ApiDescription.Client" Version="14.7.1" />
    <!-- Odporność HTTP: retry, limity czasu, bezpiecznik (Infrastructure) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Polly.Core" Version="8.9.0" />
    <!-- Testy -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
