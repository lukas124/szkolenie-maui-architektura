<?xml version="1.0" encoding="utf-8" ?>
<!-- Logowanie technika: dowolny e-mail (każdy to osobny technik z własnymi wizytami) + PIN 1234 -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FieldService.UI.MarkupExtensions"
             xmlns:pages="clr-namespace:FieldService.UI.Pages"
             xmlns:session="clr-namespace:FieldService.Presentation.Session;assembly=FieldService.Presentation"
             x:Class="FieldService.UI.Session.Pages.LoginPage"
             x:DataType="session:LoginViewModel"
             IsHeaderVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,72,24,32" Spacing="12">
            <Label Text="~/szkolenie/maui/architektura $" Style="{StaticResource SectionHeader}" />
            <Label Text="FieldService" Style="{StaticResource Headline}" />
            <Label Text="{loc:Translate Login_Subtitle}"
                   Style="{StaticResource Body}" Margin="0,0,0,16" />

            <Label Text="{loc:Translate Login_EmailLabel}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Email}" Placeholder="{loc:Translate Login_EmailPlaceholder}" Keyboard="Email"
                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Next" />
            </Border>

            <Label Text="{loc:Translate Login_PinLabel}" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
            <Border Style="{StaticResource InputFrame}">
                <Entry Text="{Binding Pin}" Placeholder="{loc:Translate Login_PinPlaceholder}" IsPassword="True" Keyboard="Numeric" MaxLength="4"
                       ReturnType="Go" ReturnCommand="{Binding SignInCommand}" />
            </Border>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerColor}" Style="{StaticResource Body}" />
            <Button Text="{loc:Translate Login_SignIn}" Command="{Binding SignInCommand}" Margin="0,8,0,0" />
            <ActivityIndicator IsRunning="{Binding SignInCommand.IsRunning}" IsVisible="{Binding SignInCommand.IsRunning}" />
            <!-- przywracanie zapamiętanej sesji przy starcie -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{loc:Translate Login_TrainingHint}" Style="{StaticResource Caption}"
                   HorizontalTextAlignment="Center" Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
