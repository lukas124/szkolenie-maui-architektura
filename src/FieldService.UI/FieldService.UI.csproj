<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI: jedyny projekt MAUI – strony, platformy i korzeń kompozycji (MauiProgram), który zna wszystkie pierścienie -->
  <PropertyGroup>
    <!-- Android zawsze; iOS tylko na macOS (wymaga Xcode i workloadu maui-ios) -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <!-- trzy konfiguracje: Debug (DEV), Test (pomiary), Release (sklep) – .NET Meteor pokazuje je na pasku stanu -->
    <Configurations>Debug;Release;Test</Configurations>
    <!-- OpenTelemetry w buildach z optymalizacjami: SDK Androida/iOS domyślnie wycina metryki i nagłówek traceparent
         (przycinanie) – bez tego w Test i Release nie byłoby metryk ani śladu od telefonu do API -->
    <MetricsSupport>true</MetricsSupport>
    <HttpActivityPropagationSupport>true</HttpActivityPropagationSupport>
    <RootNamespace>FieldService.UI</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Wersje: ApplicationDisplayVersion = to, co widzi użytkownik; ApplicationVersion = zawsze rosnący numer buildu -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>

    <!-- Szkolenie: nie blokuj buildu iOS, gdy pakiet .NET for iOS oczekuje o jedną wersję nowszego Xcode.
         W CI/produkcji usuń i trzymaj zgodne wersje. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!-- Compiled bindings także dla bindingów z ustawionym Source (x:Reference, RelativeSource) -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- Binding bez x:DataType (XC0022, XC0025) = błąd buildu: ostrzeżenia kompilatora XAML nie podlegają
         TreatWarningsAsErrors, a bariera dla XAML ma działać jak test architektury dla C# -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);XC0022;XC0025</MSBuildWarningsAsErrors>
  </PropertyGroup>

  <!-- Debug = DEV: osobna aplikacja obok wersji produkcyjnej na tym samym telefonie -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationId>pl.szkolenie.fieldservice.dev</ApplicationId>
    <ApplicationTitle>FieldService DEV</ApplicationTitle>
    <!-- HTTP bez TLS tylko w Debug: lokalne API i backend OTLP trenera (http://10.0.2.2) – Test i Release tylko HTTPS -->
    <AndroidManifestPlaceholders>usesCleartextTraffic=true</AndroidManifestPlaceholders>
  </PropertyGroup>
  <!-- Test = pomiary: jak Release (AOT, przycinanie), ale osobna aplikacja (.test) ze stroną Diagnostyka; APK do adb install -->
  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <ApplicationId>pl.szkolenie.fieldservice.test</ApplicationId>
    <ApplicationTitle>FieldService TEST</ApplicationTitle>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- to, co Release dostaje domyślnie: przycięcie zestawów i profilowane AOT – mierzymy to, co dostaje użytkownik -->
    <PublishTrimmed>true</PublishTrimmed>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidManifestPlaceholders>usesCleartextTraffic=false</AndroidManifestPlaceholders>
  </PropertyGroup>
  <!-- iOS: Test bez generowania kodu w locie – z ustawieniami Test (przycinanie) aplikacja na iOS inaczej pada przy starcie -->
  <PropertyGroup Condition="'$(Configuration)' == 'Test' And $(TargetFramework.Contains('-ios'))">
    <DynamicCodeSupport>false</DynamicCodeSupport>
  </PropertyGroup>
  <!-- Diagnostyka (strona, licznik żądań HTTP) tylko w Debug i Test – nigdy w wersji do sklepu -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Test'">
    <DefineConstants>$(DefineConstants);DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <!-- Release = PROD: wersja do sklepu -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationId>pl.szkolenie.fieldservice</ApplicationId>
    <ApplicationTitle>FieldService</ApplicationTitle>
    <AndroidManifestPlaceholders>usesCleartextTraffic=false</AndroidManifestPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E6E7C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E6E7C" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Konfiguracja aplikacji: appsettings.json + TYLKO plik bieżącej konfiguracji trafia do binarki (jak w podstawach);
         appsettings.Local.json (poza repo, .gitignore) – lokalne API i backend OTLP trenera, nadpisuje oba -->
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
    <EmbeddedResource Include="appsettings.$(Configuration).json" LogicalName="appsettings.environment.json"
                      Condition="Exists('appsettings.$(Configuration).json')" />
    <EmbeddedResource Include="appsettings.Local.json" LogicalName="appsettings.local.json"
                      Condition="Exists('appsettings.Local.json') And '$(Configuration)' != 'Release'" />
    <None Remove="appsettings*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Korzeń kompozycji zna pierścienie, które składa (reguła zależności: UI jest na zewnątrz) -->
    <ProjectReference Include="..\FieldService.Presentation\FieldService.Presentation.csproj" />
    <ProjectReference Include="..\FieldService.Infrastructure\FieldService.Infrastructure.csproj" />
  </ItemGroup>

</Project>
