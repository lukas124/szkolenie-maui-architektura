<?xml version="1.0" encoding="utf-8" ?>
<!-- Szczegóły wizyty z danych listy. Pełny ekran z akcjami (Rozpocznij, części, podpis) – Blok 07. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:FieldService.UI.MarkupExtensions"
             xmlns:visits="clr-namespace:FieldService.Presentation.Visits;assembly=FieldService.Presentation"
             x:Class="FieldService.UI.Visits.Pages.VisitDetailsPage"
             x:DataType="visits:VisitItem"
             Title="{loc:Translate VisitDetails_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Image Source="{Binding ThumbnailUrl}" WidthRequest="96" HeightRequest="96" Aspect="AspectFill" HorizontalOptions="Start" />
            <Label Text="{Binding WorkOrderNumber, StringFormat={loc:TranslateFormat VisitDetails_WorkOrder}}" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding Title}" Style="{StaticResource Headline}" />
            <Label Text="{Binding Address}" Style="{StaticResource Body}" />
            <Label Text="{Binding TimeText}" Style="{StaticResource Body}" />
            <Label Text="{Binding StatusText}" FontFamily="PlexSemiBold"
                   TextColor="{Binding Tone, Converter={StaticResource ToneToColor}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate VisitDetails_DeviceSection}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding DeviceName}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding FaultDescription}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
