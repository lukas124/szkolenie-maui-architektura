<?xml version="1.0" encoding="utf-8" ?>
<!-- Szczegóły wizyty z elementu listy. Pełny ekran z akcjami (Rozpocznij, części, podpis) – Blok 07. -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:loc="clr-namespace:FieldService.UI.MarkupExtensions"
                xmlns:pages="clr-namespace:FieldService.UI.Pages"
                xmlns:visits="clr-namespace:FieldService.Presentation.Visits;assembly=FieldService.Presentation"
                x:Class="FieldService.UI.Visits.Pages.VisitDetailsPage"
                x:DataType="visits:VisitDetailsViewModel"
                Title="{loc:Translate VisitDetails_Title}"
                CanNavigateBack="True">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Image Source="{Binding Visit.ThumbnailUrl}" WidthRequest="96" HeightRequest="96" Aspect="AspectFill" HorizontalOptions="Start" />
            <Label Text="{Binding Visit.WorkOrderNumber, StringFormat={loc:TranslateFormat VisitDetails_WorkOrder}}" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding Visit.CustomerName}" Style="{StaticResource Headline}" />
            <Label Text="{Binding Visit.AddressText}" Style="{StaticResource Body}" />
            <Label Text="{Binding Visit.TimeWindowText}" Style="{StaticResource Body}" />
            <Label Text="{Binding Visit.StatusText}" FontFamily="PlexSemiBold"
                   TextColor="{Binding Visit.Tone, Converter={StaticResource ToneToColor}}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate VisitDetails_DeviceSection}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding Visit.DeviceName}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding Visit.FaultDescription}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
