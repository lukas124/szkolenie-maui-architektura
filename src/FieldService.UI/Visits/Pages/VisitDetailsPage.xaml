<?xml version="1.0" encoding="utf-8" ?>
<!-- Szczegóły wizyty z lokalnej repliki i akcje technika. Kreator zakończenia (kroki) – Blok 09. -->
<pages:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:loc="clr-namespace:FieldService.UI.MarkupExtensions"
                xmlns:pages="clr-namespace:FieldService.UI.Pages"
                xmlns:visits="clr-namespace:FieldService.Presentation.Visits;assembly=FieldService.Presentation"
                xmlns:queries="clr-namespace:FieldService.Application.Visits.Queries;assembly=FieldService.Application"
                x:Class="FieldService.UI.Visits.Pages.VisitDetailsPage"
                x:DataType="visits:VisitDetailsViewModel"
                Title="{loc:Translate VisitDetails_Title}"
                CanNavigateBack="True">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Image Source="{Binding Details.ThumbnailUrl}" WidthRequest="96" HeightRequest="96" Aspect="AspectFill" HorizontalOptions="Start" />
            <Label Text="{Binding Details.WorkOrderNumber, StringFormat={loc:TranslateFormat VisitDetails_WorkOrder}}" Style="{StaticResource SectionHeader}" />
            <Label Text="{Binding Details.Customer.Name}" Style="{StaticResource Headline}" />
            <Label Text="{Binding Details.Customer.Address}" Style="{StaticResource Body}" />
            <Label Text="{Binding TimeWindowText}" Style="{StaticResource Body}" />
            <Label Text="{Binding StatusText}" FontFamily="PlexSemiBold" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate VisitDetails_DeviceSection}" Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding Details.DeviceName}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding Details.FaultDescription}" Style="{StaticResource Body}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{loc:Translate VisitDetails_ScopeSection}" Style="{StaticResource SectionHeader}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details.Activities}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}" Style="{StaticResource Body}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details.Parts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="queries:VisitPartLine">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <!-- TODO: Ćwiczenie 08 – R7: przycisk „Usuń” (Text="{loc:Translate VisitDetails_Remove}", Grid.Column="1", RemovePartCommand przez RelativeSource z x:DataType, CommandParameter="{Binding .}") -->
                                    <Label Style="{StaticResource Body}" VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PartId, StringFormat='• {0}'}" />
                                                <Span Text="{Binding Quantity, StringFormat=' × {0}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding SignatureText, StringFormat={loc:TranslateFormat VisitDetails_SignedBy}, TargetNullValue={loc:TranslateFormat VisitDetails_NoValidSignature}}"
                           Style="{StaticResource Caption}" />
                    <Label Text="{Binding Details.PhotoCount, StringFormat={loc:TranslateFormat VisitDetails_PhotoCount}}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{loc:Translate VisitDetails_Start}" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInProgress}">
                <Button Text="{loc:Translate VisitDetails_AddPart}" Command="{Binding AddPartCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="{loc:Translate VisitDetails_Signature}" Command="{Binding SignCommand}" Style="{StaticResource SecondaryButton}" />
                <Button Text="{loc:Translate VisitDetails_CompleteFixed}" Command="{Binding CompleteCommand}" />
            </VerticalStackLayout>
            <Button Text="{loc:Translate VisitDetails_AddPhoto}" Command="{Binding AddPhotoCommand}" Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
