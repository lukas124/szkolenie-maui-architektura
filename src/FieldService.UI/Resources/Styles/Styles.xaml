<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Style globalne. Implicit (bez x:Key) = domyślny wygląd kontrolki; explicit (z x:Key) = wybierany przez Style="{StaticResource …}".
  Kolory zależne od motywu: AppThemeBinding (jasny / ciemny).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Strony i nawigacja ===== -->
    <!-- NavigationPage.HasNavigationBar = False: systemowy pasek nawigacji ukryty — nagłówek rysuje szablon PageTemplate (Templates/PageTemplate.xaml) -->
    <Style x:Key="PageStyle" TargetType="Page">
        <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
    </Style>
    <!-- Uwaga: element dostaje tylko JEDEN styl implicit (najbliższy typ), stąd BasedOn w stylu BasePage (App.xaml) -->
    <Style TargetType="Page" ApplyToDerivedTypes="True" BasedOn="{StaticResource PageStyle}" />

    <!-- ===== Tekst ===== -->
    <!-- implicit: bez x:Key – dotyczy WSZYSTKICH Label w aplikacji -->
    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="FontFamily" Value="PlexRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- explicit: z x:Key – Style="{StaticResource Headline}" -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoBold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoBold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Tytuł w nagłówku strony (PageTemplate) -->
    <Style x:Key="HeaderTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- „// sekcja” w stylu StrefaKodera.pl -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="FontFamily" Value="MonoRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===== Kontrolki ===== -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="MonoBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceRaisedLight}, Dark={StaticResource SurfaceRaisedDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Przycisk drugorzędny (obrys) -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderWidth" Value="1.5" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PlexRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="PlexRegular" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </Style>

    <!-- ===== Karty ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Wiersz listy: jeden Grid na wiersz (płaski układ – mało elementów do zmierzenia) -->
    <Style x:Key="ListRow" TargetType="Grid">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="2" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- ===== Plakietki statusu (Controls/StatusBadge) – tło (Badge.*) i tekst (BadgeText.*) według tonu, oba z AppThemeBinding ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style x:Key="Badge.Neutral" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeNeutralLight}, Dark={StaticResource BadgeNeutralDark}}" />
    </Style>
    <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeInfoLight}, Dark={StaticResource BadgeInfoDark}}" />
    </Style>
    <Style x:Key="Badge.Success" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeSuccessLight}, Dark={StaticResource BadgeSuccessDark}}" />
    </Style>
    <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeWarningLight}, Dark={StaticResource BadgeWarningDark}}" />
    </Style>
    <Style x:Key="Badge.Danger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BadgeDangerLight}, Dark={StaticResource BadgeDangerDark}}" />
    </Style>
    <Style x:Key="BadgeText" TargetType="Label">
        <Setter Property="FontFamily" Value="PlexSemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="BadgeText.Neutral" TargetType="Label" BasedOn="{StaticResource BadgeText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadgeNeutralTextLight}, Dark={StaticResource BadgeNeutralTextDark}}" />
    </Style>
    <Style x:Key="BadgeText.Info" TargetType="Label" BasedOn="{StaticResource BadgeText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadgeInfoTextLight}, Dark={StaticResource BadgeInfoTextDark}}" />
    </Style>
    <Style x:Key="BadgeText.Success" TargetType="Label" BasedOn="{StaticResource BadgeText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadgeSuccessTextLight}, Dark={StaticResource BadgeSuccessTextDark}}" />
    </Style>
    <Style x:Key="BadgeText.Warning" TargetType="Label" BasedOn="{StaticResource BadgeText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadgeWarningTextLight}, Dark={StaticResource BadgeWarningTextDark}}" />
    </Style>
    <Style x:Key="BadgeText.Danger" TargetType="Label" BasedOn="{StaticResource BadgeText}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BadgeDangerTextLight}, Dark={StaticResource BadgeDangerTextDark}}" />
    </Style>

    <!-- Wypełnienie pola tekstowego (Entry w ramce) -->
    <Style x:Key="InputFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceRaisedDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderStrongLight}, Dark={StaticResource BorderStrongDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

</ResourceDictionary>
