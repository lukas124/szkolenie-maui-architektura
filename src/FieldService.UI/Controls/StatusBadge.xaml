<?xml version="1.0" encoding="utf-8" ?>
<!-- Plakietka statusu: wyświetla ton i tekst, nie decyduje (ton liczy VisitItemFactory w Presentation).
     Wewnątrz wiąże się z własnymi właściwościami przez x:Reference – BindingContext zostaje od strony. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FieldService.UI.Controls"
             x:Class="FieldService.UI.Controls.StatusBadge"
             x:Name="root">
    <Border x:DataType="controls:StatusBadge"
            Style="{Binding Tone, Source={x:Reference root}, Converter={StaticResource ToneToBadge}}"
            HorizontalOptions="Start">
        <Label x:DataType="controls:StatusBadge"
               Style="{Binding Tone, Source={x:Reference root}, Converter={StaticResource ToneToBadgeText}}"
               Text="{Binding Text, Source={x:Reference root}}" />
    </Border>
</ContentView>
