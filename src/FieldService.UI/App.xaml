<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:FieldService.UI.Converters"
             x:Class="FieldService.UI.App">
    <!-- Zasoby globalne: kolory i style dostępne w całej aplikacji -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- VisitTone (Presentation) → kolor; dostępny na wszystkich stronach -->
            <converters:ToneToColorConverter x:Key="ToneToColor" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
