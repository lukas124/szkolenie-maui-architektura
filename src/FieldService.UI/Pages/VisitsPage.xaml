<?xml version="1.0" encoding="utf-8" ?>
<!-- Lista wizyt na dziś -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldService.UI.ViewModels"
             xmlns:models="clr-namespace:FieldService.UI.Models"
             x:Class="FieldService.UI.Pages.VisitsPage"
             x:DataType="vm:VisitsViewModel"
             Title="Wizyty na dziś">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Odśwież" Command="{Binding LoadCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,12" Spacing="2">
            <Label Text="{Binding Summary}" Style="{StaticResource CardTitle}" />
            <Label Text="{Binding LastUpdated}" Style="{StaticResource Caption}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Start" />
            <Label Text="Tryb offline – dane zapisane w telefonie" IsVisible="{Binding IsOffline}"
                   TextColor="{StaticResource WarningColor}" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Visits}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Brak wizyt" Style="{StaticResource Body}" HorizontalOptions="Center" Margin="0,48" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:VisitItem">
                        <Border Style="{StaticResource Card}" Margin="16,6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                <Image Source="{Binding Avatar}" WidthRequest="56" HeightRequest="56" Aspect="AspectFill" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                        <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{Binding StatusColor}"
                                               FontFamily="PlexSemiBold" FontSize="13" />
                                    </Grid>
                                    <Label Text="{Binding TimeText}" Style="{StaticResource Body}" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                    <Label Text="Brygada (2 techników)" IsVisible="{Binding IsBrigade}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
