<?xml version="1.0" encoding="utf-8" ?>
<!-- Ekran startowy szkieletu: nazwa aplikacji, wersja i adres API z appsettings.json -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldService.UI.Pages.MainPage"
             Title="FieldService">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="20">

            <VerticalStackLayout Spacing="6">
                <Label Text="~/szkolenie/maui/architektura $" Style="{StaticResource SectionHeader}" />
                <Label Text="FieldService" Style="{StaticResource Headline}" />
                <Label Text="Wizyty serwisowe w terenie. Aplikacja szkoleniowa „Architektura aplikacji w .NET MAUI”."
                       Style="{StaticResource Body}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="// checkpoint 01-start" Style="{StaticResource SectionHeader}" />
                    <Label Text="Szkielet bez architektury" Style="{StaticResource CardTitle}" />
                    <Label Style="{StaticResource Body}"
                           Text="Pięć projektów czeka pustymi pokojami: Domain, Application, Infrastructure, Presentation i UI. Meble wniesiemy razem w kolejnych blokach." />
                    <Label x:Name="ApiLabel" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Label x:Name="VersionLabel" Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
