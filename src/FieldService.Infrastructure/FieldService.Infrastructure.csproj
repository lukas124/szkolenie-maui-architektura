<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure: adaptery danych (HTTP, SQLite, później cache). Czysty .NET, zna Application i Domain. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FieldService.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- OpenTelemetry: SDK, instrumentacja HttpClient, eksporter OTLP (i konsolowy w Debug) – tylko tutaj -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <PackageReference Include="NSwag.ApiDescription.Client" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <!-- Klient API generowany przy każdym buildzie z pliku specyfikacji w repo (obj/, nie edytujemy i nie commitujemy).
       Aktualizacja specyfikacji: tools/update-openapi.sh -->
  <ItemGroup>
    <OpenApiReference Include="Api/openapi/fieldservice.v1.json"
                      CodeGenerator="NSwagCSharp"
                      Namespace="FieldService.Infrastructure.Api"
                      ClassName="FieldServiceApiClient"
                      Options="/UseBaseUrl:false /JsonLibrary:SystemTextJson /GenerateClientInterfaces:false /GenerateOptionalParameters:true /ExceptionClass:ApiException /TypeAccessModifier:internal /ClientClassAccessModifier:internal" />
  </ItemGroup>

  <!-- wygenerowany klient i DTO są internal (DTO nie wychodzą z Infrastructure – ACL), testy bram widzą je -->
  <ItemGroup>
    <InternalsVisibleTo Include="FieldService.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldService.Application\FieldService.Application.csproj" />
  </ItemGroup>

</Project>
