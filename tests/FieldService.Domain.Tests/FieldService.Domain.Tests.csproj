  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FieldService.Domain\FieldService.Domain.csproj" />
  </ItemGroup>

</Project>
